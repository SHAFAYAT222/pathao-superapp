# Pathao Super-App Production & Development Environment Configuration
# Copy this file to .env and replace placeholder values with your credentials.

# -----------------------------------------------------------------------------
# Frontend Client Configuration (Vite import.meta.env)
# -----------------------------------------------------------------------------

# Base URL for the Pathao backend REST API services (leave empty to use relative /api proxy in development)
VITE_API_BASE_URL=http://localhost:5000

# Supabase Realtime Database & Auth (Optional if using internal Express / Postgres)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_supabase_anon_key_here

# Mapbox Access Token (or Google Maps API Key for geospatial rendering)
VITE_MAPBOX_TOKEN=pk.eyJ1IjoicGF0aGFvLWRlbW8iLCJhIjoiY2x6dGV4YW1wbGUwMDFqcXZ3In0.example_mapbox_token

# -----------------------------------------------------------------------------
# Backend API & Server Configuration (Node.js process.env)
# -----------------------------------------------------------------------------

# Server listening port
PORT=5000

# Node environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Postgres / Supabase direct connection string (optional)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathao_superapp

# CORS allowed origins (comma separated or * for open development)
CORS_ORIGIN=*
